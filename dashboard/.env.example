# CodeBridge Dashboard Environment Configuration

# Set to "true" to use client-side MSW mocks for all services; "false" routes to real backend
VITE_USE_MOCKS=true

# Gateway URL for proxying in dev when mocks are disabled
VITE_GATEWAY_URL=https://<partner-url>

# Per-service mock fallback (comma-separated list of service folder names, e.g. "talent,identity")
# When VITE_USE_MOCKS=false, only services listed here will be intercepted by MSW
VITE_MOCK_SERVICES=

# GitHub integration mode: "mock" or "off"
VITE_GITHUB_MODE=off

# API base path behind gateway
VITE_API_BASE_URL=/api/v1

# Base URL path for assets and SPA routing
VITE_BASE_PATH=/

# Cross-app navigation URLs (running locally on their respective ports)
VITE_SIGNIN_URL=http://localhost:5173/login
VITE_ACCOUNT_URL=http://localhost:5176/
VITE_WORKSPACE_URL=http://localhost:5177/

# Realtime WebSocket path (proxied to notification service)
VITE_WS_URL=/api/v1/notifications/ws

# Developer tools drawer enabled
VITE_DEV_TOOLS=true

# Grafana Dashboard URL (optional; use the host given by the backend owner, or localhost when Grafana runs on this machine)
# When empty or omitted, the analytics page shows the "not configured" guidance state.
VITE_GRAFANA_URL=http://<backend-host>:3001/d/codebridge-analytics/codebridge-platform-analytics?orgId=1&kiosk

# AI developer brief feature flags: "true" = on, "false" = off, unset = on when VITE_USE_MOCKS is "true", otherwise off.
# Turn on only when the backend supports it (project, github, and code-context services).
VITE_FEATURE_AI_BRIEF=
VITE_DRAFT_PUBLISH=

# AI requirement verification scorecard (Part B): "true" = on, "false" = off, unset = on when VITE_USE_MOCKS is "true", otherwise off.
VITE_FEATURE_AI_VERIFICATION=
