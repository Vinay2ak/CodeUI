# CodeBridge Freelancer Workspace Environment Variables
VITE_USE_MOCKS=false
VITE_GATEWAY_URL=https://<partner-url>
VITE_MOCK_SERVICES=
VITE_GITHUB_MODE=off
VITE_API_BASE_URL=/api/v1
VITE_BASE_PATH=/
VITE_SIGNIN_URL=http://localhost:5173/login
VITE_REGISTER_URL=http://localhost:5173/register
VITE_DASHBOARD_URL=http://localhost:5175
VITE_ACCOUNT_URL=http://localhost:5176/
VITE_WS_URL=/api/v1/notifications/ws
VITE_DEV_TOOLS=true
VITE_MOCK_TOKEN_TTL_SECONDS=900

# AI assistant feature flags (turn on only when the backend supports it)
# VITE_FEATURE_AI: "true" = on, "false" = off, unset = on when VITE_USE_MOCKS is "true", otherwise off
VITE_FEATURE_AI=
# VITE_AI_FEATURES: optional comma list of context, ask, explain, selfcheck, draft (empty = all)
VITE_AI_FEATURES=
