# CodeBridge Auth App — Environment Configuration Template
# Copy this file to .env and configure for local or remote backend development.

# Set to "true" to use simulated MSW mocks for all services, or "false" to connect to real backend
VITE_USE_MOCKS=false

# Remote or local API Gateway URL (used when VITE_USE_MOCKS=false)
VITE_GATEWAY_URL=https://<partner-url>

# Per-service mock fallback (comma-separated list of service folder names, e.g. "talent,github")
# Empty means all non-mocked services reach the real backend
VITE_MOCK_SERVICES=

# GitHub integration mode: "mock" or "off"
VITE_GITHUB_MODE=off

# Cross-application frontend navigation URLs (localhost ports)
VITE_DASHBOARD_URL=http://localhost:5175
VITE_FREELANCER_URL=http://localhost:5177

# Production: Vercel rewrites do NOT proxy WebSockets, so point straight at Render.
# VITE_WS_URL=wss://codebridge-backend.onrender.com/api/v1/notifications/ws
